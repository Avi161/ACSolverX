__pycache__/
*.pyc
.venv/
.DS_Store
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
# Runs write results/<name>/; the certificates (paths.jsonl) are regenerated by rerunning the config,
# the small summary.json and config.json of the published runs are tracked.
results/*/paths.jsonl
# AC1M is shipped compressed (data/AC1M.txt.gz); don't track the decompressed copy.
data/AC1M.txt
.env
# Per-row arrays of the rank-n sweeps are regenerated like paths.jsonl.
results/*/rows/
# Local agent worktrees.
.claude/
